+/* The managed fixture keeps QEMU's BOT/SCSI engine and only changes the
+ * interface descriptor. Ordinary usb-storage remains class 08. */
+static const USBDescMSOS managed_msos = {
+    .CompatibleID = "WINUSB",
+    .DeviceInterfaceGUID = L"{CDB3B5AD-293B-4663-AA36-1AAE46463776}",
+};
+
+static const USBDescDevice *managed_device_desc(MSDState *s,
+                                               const USBDescDevice *src,
+                                               unsigned index)
+{
+    USBDescDevice *dev;
+    USBDescConfig *conf;
+    USBDescIface *iface;
+
+    if (!src) {
+        return NULL;
+    }
+    dev = &s->fixture_devices[index];
+    conf = &s->fixture_configs[index];
+    iface = &s->fixture_ifaces[index];
+    *dev = *src;
+    *conf = src->confs[0];
+    *iface = conf->ifs[0];
+    iface->bInterfaceClass = 0xff;
+    conf->ifs = iface;
+    dev->confs = conf;
+    return dev;
+}
