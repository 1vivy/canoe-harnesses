+/* A single GUID encoded as REG_MULTI_SZ, including both trailing NULs. */
+static int usb_desc_msos_prop_guid(uint8_t *dest, const wchar_t *guid)
+{
+    struct msos_prop *prop = (void *)dest;
+    struct msos_prop_data *data;
+    int length = sizeof(*prop);
+    int chars = wcslen(guid) + 2;
+    int i;
+
+    prop->dwPropertyDataType = cpu_to_le32(MSOS_REG_MULTI_SZ);
+    length += usb_desc_msos_prop_name(prop, L"DeviceInterfaceGUIDs");
+    data = (void *)(dest + length);
+    data->dwPropertyDataLength = cpu_to_le32(chars * 2);
+    length += sizeof(*data);
+    memset(data->bPropertyData, 0, chars * 2);
+    for (i = 0; guid[i]; i++) {
+        data->bPropertyData[i * 2] = usb_lo(guid[i]);
+        data->bPropertyData[i * 2 + 1] = usb_hi(guid[i]);
+    }
+    length += chars * 2;
+    prop->dwLength = cpu_to_le32(length);
+    return length;
+}
